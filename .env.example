# Application Settings
APP_NAME=ca-assistant
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server Settings
HOST=0.0.0.0
PORT=8000

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================
# Supported providers: openai, azure_openai, anthropic
LLM_PROVIDER=azure_openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# Azure OpenAI Configuration (Recommended)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=your-gpt4-deployment-name
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=4096

# =============================================================================
# EMBEDDING CONFIGURATION
# =============================================================================
# For OpenAI: use model name
EMBEDDING_MODEL=text-embedding-3-small
# For Azure OpenAI: set AZURE_OPENAI_EMBEDDING_DEPLOYMENT above

# =============================================================================
# QDRANT VECTOR DATABASE CONFIGURATION
# =============================================================================
# Qdrant is used for storing and searching document embeddings.
# Run with Docker: docker-compose up -d
# Or standalone: docker run -p 6333:6333 -v qdrant_data:/qdrant/storage qdrant/qdrant

# Local/Docker Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents

# For Qdrant Cloud (https://cloud.qdrant.io), set URL and API_KEY:
# QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key

# Embedding dimension (must match your embedding model)
# OpenAI text-embedding-3-small: 1536
# OpenAI text-embedding-3-large: 3072
EMBEDDING_DIMENSION=1536

# RAG Configuration
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5

# Document Upload Configuration
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.txt,.docx,.md

# System Prompt (can be overridden per conversation)
DEFAULT_SYSTEM_PROMPT=You are a helpful AI assistant specialized in accounting and financial matters. You provide accurate, professional advice while being conversational and approachable.

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120
